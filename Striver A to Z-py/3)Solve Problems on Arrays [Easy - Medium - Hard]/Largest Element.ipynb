    "#optimal-approach\n",
    "class Solution:\n",
    "    def largestElement(self, nums):\n",
    "        maxi = nums[0]\n",
    "        for i in range(len(nums)):\n",
    "            if maxi<nums[i]:\n",
    "                maxi = nums[i]\n",
    "        return maxi\n",
    "ans = Solution()\n",
    "print(ans.largestElement([9,8,4,8,3,8,1,2,5,11]))"
   ]
  }
