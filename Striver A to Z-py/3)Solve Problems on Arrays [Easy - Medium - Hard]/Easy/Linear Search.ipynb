    "#optimal-1 approach\n",
    "class Solution:\n",
    "    def linearSearch(self, nums, target):\n",
    "        for i in range(len(nums)):\n",
    "            if nums[i] == target:\n",
    "                return i\n",
    "        return -1\n"
